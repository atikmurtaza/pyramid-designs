# Public browser configuration. These values are not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 2C staff sessions use only the public project URL/publishable key above.
# Do not add staff passwords, access tokens, refresh tokens or TOTP secrets here.

# Server-only Phase 2A database connections. Copy exact values from the
# development Supabase project's Connect panel; do not construct or commit them.
DATABASE_URL=
DIRECT_URL=

# Server-only protection for temporary compatibility endpoints.
COMPATIBILITY_PROBE_SECRET=
CRON_SECRET=

# Reserved server-only names for later approved phases.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
