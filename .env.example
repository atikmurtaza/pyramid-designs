# Supabase Auth only: public browser configuration, not database credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 2C staff sessions use only the public project URL/publishable key above.
# Do not add staff passwords, access tokens, refresh tokens or TOTP secrets here.

# Server-only Neon application database. No real URLs belong in this file.
# DATABASE_URL: approved pooled (-pooler) endpoint, dedicated runtime role.
# DIRECT_URL: approved direct (non-pooler) endpoint, migration/owner role.
# Require sslmode=verify-full and verified server identity on both Neon URLs.
# Install only DATABASE_URL in the web runtime; DIRECT_URL is operator tooling.
# Never use a Neon Console-created privileged owner login as the runtime role.
DATABASE_URL=
DIRECT_URL=

# Server-only protection for temporary compatibility endpoints.
COMPATIBILITY_PROBE_SECRET=
CRON_SECRET=

# Unused by current Supabase Auth and Neon database access; do not provision it.
SUPABASE_SERVICE_ROLE_KEY=
# Retained private Google Drive candidate-file storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_ID=

# Server-only C2B email configuration. Selection and every fixed identity are required.
# Use a private Sending-only Resend key restricted to mail.pyramiddesigns.co.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=applications@mail.pyramiddesigns.co
EMAIL_FROM_NAME=Pyramid Designs
EMAIL_REPLY_TO_MODE=fixed
EMAIL_REPLY_TO_ADDRESS=contact@pyramiddesigns.co
# Isolated C2B rehearsal only; never a production recipient override.
PHASE2IC2B_LIVE_RECIPIENT=contact@pyramiddesigns.co

# Phase 2I-D server-only challenge contract; does not activate production intake.
# Exact approved HTTPS origin, without trailing slash. No permissive default.
PUBLIC_INTAKE_ORIGIN=
PUBLIC_INTAKE_CHALLENGE_PROVIDER=
# Private secret: configure only in the isolated server environment, never in chat.
TURNSTILE_SECRET_KEY=
# Public widget identifier, kept server-side until a separately approved UI exists.
TURNSTILE_SITE_KEY=
