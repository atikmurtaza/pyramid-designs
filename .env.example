# Contract: docs/operations/production-environment.md. Placeholders only.
# Supabase Auth/client public configuration; these are not database credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 2C staff sessions use only the public project URL/publishable key above.
# Do not add staff passwords, access tokens, refresh tokens or TOTP secrets here.

# Server-only Supabase PostgreSQL; restricted application runtime LOGIN.
# DATABASE_URL: verified Supavisor SESSION MODE (5432), or proven direct path.
# DIRECT_URL: migration/admin only; direct or verified session mode for IPv4.
# Require sslmode=verify-full; supply the verified provider CA if needed.
# Never use postgres/service_role/secret keys as the normal runtime identity.
# Install only DATABASE_URL in web runtime; DIRECT_URL is operator tooling.
DATABASE_URL=
DIRECT_URL=

# Development-only; production compatibility endpoints always return 404.
COMPATIBILITY_PROBE_SECRET=
# Server-only worker/readiness bearer, at least 32 random characters.
CRON_SECRET=

# Deployment does not activate sensitive production capabilities.
PRODUCTION_STAFF_ENABLED=false
PRODUCTION_WORKER_ENABLED=false
PRODUCTION_EMAIL_ENABLED=false
PRODUCTION_DRIVE_ENABLED=false
# Retained private Google Drive candidate-file storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_ID=

# Server-only C2B email configuration. Selection and every fixed identity are required.
# Use a private Sending-only Resend key restricted to mail.pyramiddesigns.co.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=applications@mail.pyramiddesigns.co
EMAIL_FROM_NAME=Pyramid Designs
EMAIL_REPLY_TO_MODE=fixed
EMAIL_REPLY_TO_ADDRESS=contact@pyramiddesigns.co

# Phase 2I-D server-only challenge contract; does not activate production intake.
# Exact approved HTTPS origin, without trailing slash. No permissive default.
PUBLIC_INTAKE_ORIGIN=
PUBLIC_INTAKE_CHALLENGE_PROVIDER=
# Private secret: configure only in the isolated server environment, never in chat.
TURNSTILE_SECRET_KEY=
# Public widget identifier, kept server-side until a separately approved UI exists.
TURNSTILE_SITE_KEY=
